# Dockerfile para despliegue en Render.com
# ==========================================
# Usa python:3.12-slim (Debian) — NO incluye gobuster ni las herramientas Kali.
# Las herramientas de escaneo que no estén disponibles se omiten automáticamente.

FROM python:3.12-slim

# Instalar solo las herramientas disponibles en Debian
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        nmap \
        nikto \
        curl \
        sqlite3 \
        dirb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /app

# Copiar e instalar dependencias Python
COPY webapp/requirements.txt ./webapp-requirements.txt
RUN pip install --no-cache-dir -r webapp-requirements.txt

# Copiar código fuente
COPY src/ ./src/
COPY webapp/ ./webapp/
COPY config/ ./config/
COPY scripts/ ./scripts/
COPY README.md ./

# Crear carpetas de trabajo
RUN mkdir -p outputs reports data logs

EXPOSE 8080

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV SCAN_MODE=web

# Render inyecta $PORT; usamos 8080 como fallback para desarrollo local
CMD ["/bin/sh", "-c", "python3 -m uvicorn webapp.main:app --host 0.0.0.0 --port ${PORT:-8080}"]